OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# OrcaRouter (optional): run the `openai:` model fields through OrcaRouter's
# OpenAI-compatible gateway to reach 180+ models under one key.
# Put your sk-orca- key in OPENAI_API_KEY above, uncomment the line below, and
# use namespaced model IDs such as `openai:anthropic/claude-opus-5`.
# See https://www.orcarouter.ai
# OPENAI_API_BASE=https://api.orcarouter.ai/v1
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false