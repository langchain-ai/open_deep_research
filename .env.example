OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
MINIMAX_API_KEY=
# Optional MiniMax endpoint selection. Set the region ("global_en" or "cn_zh"), or
# override the OpenAI-compatible base URL directly with MINIMAX_API_BASE.
MINIMAX_API_REGION=global_en
MINIMAX_API_BASE=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false